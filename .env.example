VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_KHAN_PAYMENT_WALLET=
# VITE_SOLANA_RPC_URL IS RETIRED AND IS DELIBERATELY NOT LISTED HERE.
#
# It used to sit at this line reading "set this to a dedicated provider
# (Helius, QuickNode, ...) for reliable holder counts" — advice that, followed
# literally, published the provider key to every visitor, because Vite inlines
# every VITE_-prefixed value into the client bundle. That is exactly what
# happened once already.
#
# The keyed provider URL goes in SOLANA_RPC_URL (server-side, further down).
# If VITE_SOLANA_RPC_URL is still set in the Netlify UI: delete it and rotate
# the key it contained.

# Optional, free block-explorer API keys for accurate EVM token age
# (contract deployment timestamp) and upgradeable-contract detection.
# Get a free key at etherscan.io / bscscan.com / basescan.org /
# polygonscan.com. Each chain works independently - leave any blank to
# keep that chain's age reported as "Unknown" instead of guessed.
VITE_ETHERSCAN_API_KEY=
VITE_BSCSCAN_API_KEY=
VITE_BASESCAN_API_KEY=
VITE_POLYGONSCAN_API_KEY=

# Card payments (Stripe) - set on the frontend build (VITE_ vars) and as
# Netlify Function env vars (server-side, never exposed to the browser).
#
# Card payments are OFF unless VITE_STRIPE_ENABLED is exactly "true" AND a
# publishable key is present (see src/stripeCheckout.js isCardPaymentEnabled).
# Until then the UI shows only Wallet + Manual Crypto — no card buttons, no
# "not configured" notices. To turn Stripe on later: add the keys below, create
# the Products/Prices, point the webhook, and set VITE_STRIPE_ENABLED=true.
VITE_STRIPE_ENABLED=false
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_SUPPORTER_PRICE_ID=

# Optional email notifications for Support tickets, project Reports, and
# account emails (verification, password reset). Server-side only - read by
# netlify/functions/_email.mjs and auth-forgot-password.mjs via process.env,
# never a VITE_ var, so it is never bundled into the browser build. Reports/
# tickets/account emails keep working with no email sent if left blank.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
KHAN_ADMIN_NOTIFY_EMAIL=

# KHAN Holder Analytics (admin module) - server-side only, used by the
# netlify/functions/khan-holders-* indexer functions, never shipped to the
# browser. Optional: get a free key at helius.dev for faster/more reliable
# indexing (enhanced RPC, higher rate limits). Without it, the indexer falls
# back to plain Solana RPC (SOLANA_RPC_URL, or the public endpoint) - slower
# but fully functional, and works unmodified on Pump.fun today and on
# Raydium after KHAN graduates.
HELIUS_API_KEY=

# SOLANA_RPC_URL - SERVER-SIDE ONLY. The scanner's Solana RPC endpoint.
#
# This is where a keyed provider URL belongs (Helius, QuickNode, Triton, ...).
# It is read by netlify/functions/solana-rpc.mjs, which proxies the scanner's
# read-only JSON-RPC calls, by the khan-holders-* indexer, and — since the
# payment-path fix — by verify-solana-payment.mjs. It is NOT a VITE_ variable,
# so it is never bundled into the browser.
#
# SET THIS ONE. verify-solana-payment.mjs confirms real customer payments on
# chain. Left blank it falls back to api.mainnet-beta.solana.com, which is
# rate-limited hard enough that a throttled lookup is indistinguishable from a
# transaction that does not exist — i.e. a paying customer told their payment
# could not be verified.
#
# DO NOT put a keyed URL in a VITE_ variable. Vite inlines every VITE_-prefixed
# value into the client bundle, where it is readable by any visitor. A previous
# deployment set VITE_SOLANA_RPC_URL to a keyed Helius endpoint and shipped the
# key to every browser. That variable is retired: the payment verifier still
# reads it as a LAST resort so a half-migrated deployment keeps working, but
# nothing should be setting it and it must never be re-added.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# VITE_SOLANA_PUBLIC_RPC_URL - PUBLIC, shipped to the browser.
#
# Used only by wallet connection, payment verification and Launchpad minting,
# which submit transactions and confirm them over a websocket and therefore
# cannot go through a stateless function. WHATEVER THIS POINTS AT IS PUBLIC:
# leave it blank to use the public endpoint, or set a domain-restricted /
# public-scoped provider URL. Never put a privileged key here.
VITE_SOLANA_PUBLIC_RPC_URL=

# ── Paid verification (Phase 2) ───────────────────────────────────────────────
#
# VERIFY_TREASURY_WALLET - SERVER-SIDE. Where verification revenue lands.
#
# Optional but RECOMMENDED. Falls back to VITE_KHAN_PAYMENT_WALLET so the
# feature is not dead on a deployment that has not set it, and the order-create
# response reports which one is in use so that fallback is never silent.
#
# Use a separate address: a $9/month subscription stream and a $149/$399
# one-time stream landing on one wallet makes reconciliation, accounting and any
# future webhook filtering needlessly painful to unpick.
#
# A receiving address is public by nature, so there is nothing secret here — it
# is server-side only because nothing in the browser needs to choose it.
VERIFY_TREASURY_WALLET=

# VERIFY_MIN_SCORE - SERVER-SIDE. The Trust Score floor below which verification
# is not sold. Defaults to 40 (src/lib/verificationTiers.js).
#
# Deliberately NOT a VITE_ variable. The client reads the floor off the
# verify-quote response, so there is exactly one authority for it and a browser
# can never be shown a different threshold than the one the sale is judged
# against.
#
# WHICH SCORE IT MEASURES. The CLIENT-LANE score held in the Trust Graph corpus
# — the number produced by the full ~18-provider scan and the only one a visitor
# has ever seen on the site. This platform computes a second, narrower score
# server-side (_rescanEngine.mjs documents the same token reading 35 and 76 at
# one instant); the two are not comparable and this floor does not use it. The
# consequence is that a token nobody has scanned cannot be quoted, and the team
# is asked to run the free scan first.
VERIFY_MIN_SCORE=40

# DATABASE_URL is what closes the duplicate-sale race. See the header of
# netlify/functions/_verificationOrders.mjs: at most one active verification may
# exist per (chain, contract), and Netlify Blobs has no constraint that can
# enforce it. With DATABASE_URL set and db/migrations/0002_verification.sql
# applied (`node scripts/db-migrate.mjs`), the claim becomes an INSERT ... ON
# CONFLICT that two concurrent activations cannot both win. Without it, the
# check degrades to a Blobs read and a narrow race stays open — a duplicate is
# then caught at activation, recorded with its payment signature, and refundable
# rather than silently double-sold.

# ── Early Stage auto-discovery ────────────────────────────────────────────────
#
# Discovery is REAL-ONLY and needs no configuration. All three sources are free
# and keyless:
#   DexScreener  latest token profiles  -> genuinely newly-launched tokens
#   CoinGecko    trending search        -> what people are looking at right now
#   GitHub       recent web3 repos      -> projects building in the open
#
# There is NO flag to set. The old EARLY_STAGE_DISCOVERY_REAL variable has been
# REMOVED along with the code it gated. Setting it now does nothing.
#
# What it used to do, and why it is gone: real providers ran only when it was
# set to "1". It was never documented here, so in practice it was unset, and the
# default path served ~18 INVENTED projects — fabricated names, tickers,
# websites, X handles and contract addresses — through the scheduled worker into
# the public Early Stage list, badged "Auto Discovered · Source: DexScreener".
# On a trust product that is the worst possible defect, so the fabricated
# providers were deleted outright rather than left behind a flag someone could
# flip back. See netlify/functions/_discoveryProviders.mjs.
#
# BEHAVIOUR WHEN A SOURCE IS UNREACHABLE: that provider contributes nothing and
# the run discovers less. Nothing is substituted. If every source is down the
# Early Stage list shows only real community submissions — an empty or short
# list is a true statement; a full one built from fiction is not.
#
# The two keys below are OPTIONAL and only raise rate limits. Their absence
# costs coverage, never truthfulness. Both are server-side (no VITE_ prefix).
COINGECKO_API_KEY=
GITHUB_TOKEN=

# ── KHAN Growth OS (private admin console at /console) ────────────────────────
# The Growth OS runs WITHOUT any of these. The event log, funnel, cohort
# retention, YouTube/TikTok attribution and content-demand ranking are all
# deterministic and need no AI. Only the analyst layer requires a key.
#
# ANTHROPIC_API_KEY: server-side only, never a VITE_ var, so it is never bundled
# into the browser. Without it the console shows every metric as normal and
# reports the analyst layer as switched off.
ANTHROPIC_API_KEY=

# Hard monthly ceiling on AI spend, in USD. Enforced in
# netlify/functions/_aiBudget.mjs BEFORE every call, and the ledger fails
# CLOSED - if it cannot be read, no spend is authorised. Default 10 if unset.
# The team runs weekly on Haiku 4.5 ($1/$5 per 1M tokens), so realistic spend is
# a few dollars a month; the cap exists to bound a bug, not normal use.
KHAN_AI_MONTHLY_BUDGET_USD=10

# Authentication (email/password accounts)
# AUTH_SECRET: random secret used to sign JWT tokens - generate with: openssl rand -hex 32
# Keep this secret and never commit it. Changing it invalidates all existing sessions.
AUTH_SECRET=

# LIFECYCLE_UNSUBSCRIBE_SECRET (optional, server-side only) - signs the one-click
# unsubscribe AND resubscribe capabilities in lifecycle emails
# (netlify/functions/_lifecycleToken.mjs). The two are separate capabilities
# under the same key, so an opt-out link cannot be replayed as an opt-in.
# Falls back to AUTH_SECRET when unset, so no action is needed; set a dedicated
# value if you would rather the two capabilities not share a key (they are
# domain-separated by an "unsub:"/"resub:" prefix, so sharing is safe). With
# NEITHER set, the mailer still sends but every unsubscribe link answers
# "preferences cannot be changed right now" - so if AUTH_SECRET is absent in
# production, set this one before enabling RESEND_API_KEY. Never a VITE_ var.
LIFECYCLE_UNSUBSCRIBE_SECRET=

# ── Phase 4/5: public profiles, receipts and the delivery queue ───────────────
#
# EVERY VARIABLE BELOW IS OPTIONAL. Phase 4 and Phase 5 run without any of them:
# the public profile renders, the sitemap generates, receipts are written, and
# the queue drains. What each one adds is stated so an operator can decide,
# rather than setting all of them because a template said so.

# KHAN_ADMIN_TELEGRAM_CHAT_ID (optional, server-side only)
# Where verification lifecycle alerts are sent — new paid order, ownership
# needing review, activation, expiry, revocation, duplicate sales requiring a
# refund, and dead-letter jobs. Requires TELEGRAM_BOT_TOKEN to be set as well;
# with either missing, every alert is a silent no-op and nothing else changes.
#
# THIS MAY BE A GROUP, AND THE CODE ASSUMES IT IS. Messages deliberately carry
# NO payment signature, NO full wallet address, NO customer email and NO admin
# notes — only an order id and a link into the passcode-gated console. See the
# header of netlify/functions/_verificationAlerts.mjs.
KHAN_ADMIN_TELEGRAM_CHAT_ID=

# RECEIPT_NUMBER_SALT (optional, server-side only)
# Salts the HMAC that derives a receipt number from an order id. It only has to
# be STABLE, not secret — the number is an identifier printed on the receipt,
# never an authorisation (access is a real check in verify-receipt.mjs). Falls
# back to a fixed default, so leaving it unset is safe.
#
# CHANGING IT AFTER GOING LIVE RE-NUMBERS EVERY FUTURE RECEIPT. Already-issued
# receipts keep their stored number — they are write-once — so the effect is a
# discontinuity in the series, not a rewrite of history. Set it once, early, or
# not at all.
RECEIPT_NUMBER_SALT=

# DATABASE_URL is documented above and stays optional — but Phase 5 gives it a
# SECOND job worth knowing about. Alongside the verification exclusivity lock it
# already backs, it now also holds the queue LEASE (db/migrations/0003), which is
# what stops two workers processing one job. Without it the lease degrades to a
# write-then-reread check that is racy in principle; every job handler is
# idempotent anyway, so a double-delivery is absorbed rather than harmful. See
# the header of netlify/functions/_eventQueue.mjs for the full trade.
#
# HOW MIGRATIONS REACH PRODUCTION. This project is on Netlify Managed Database,
# which never reveals a production connection string — DATABASE_URL is a SECRET
# variable, so `netlify env:get` returns only its last four characters and there
# is no reveal in the UI. That is by design: Netlify applies migrations itself,
# during the deploy, from netlify/database/migrations/ (mirrored from
# db/migrations/ and kept identical by scripts/verify-migrations.mjs).
#
# So there is nothing to run by hand for production — push, and the deploy
# applies any pending migration immediately before publishing. A failing
# migration blocks the publish.
#
#   Locally:  netlify dev  (one terminal)
#             netlify database migrations apply
#
#   Against a database you DO hold a connection string for:
#             node scripts/db-migrate.mjs
#
# Verify it landed in the database the APP uses (not merely the one the deploy
# migrated) in the console: /console -> Jobs & delivery.
